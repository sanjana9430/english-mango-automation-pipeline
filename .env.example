# Copy to .env and fill in. Never commit the real .env file.

ANTHROPIC_API_KEY=

# From SETUP.md step 1
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_GRAPH_VERSION=v19.0

# Where the curated assets are publicly served (automation-pipeline/public_assets/,
# deployed as the "english-mango-assets" Render static site)
PUBLIC_ASSET_BASE_URL=https://english-mango-assets.onrender.com

# Fine-grained GitHub PAT, scoped to ONLY this repo, "Contents: write" permission.
# Needed on every run (asset-rotation state push, see assets.py/git_sync.py),
# not just reel days.
GITHUB_PUSH_TOKEN=

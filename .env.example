# Copy to .env and fill in. Never commit the real .env file.

ANTHROPIC_API_KEY=

# From SETUP.md step 1
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_GRAPH_VERSION=v19.0

# Where the curated assets are publicly served (automation-pipeline/public_assets/,
# deployed as the "english-mango-assets" Render static site)
PUBLIC_ASSET_BASE_URL=https://english-mango-assets.onrender.com

# Fine-grained GitHub PAT, scoped to ONLY this repo, "Contents: write" permission.
# Used solely to push the rendered reel video to public_assets/reel-latest.mp4
# on reel days — not needed for carousel-only use.
GITHUB_PUSH_TOKEN=

# Every reel fails QA and queues for review until this is deliberately "true" —
# reel_render_engine.py's music bed is still a synthesized placeholder. See SETUP.md.
ALLOW_PLACEHOLDER_MUSIC=false
